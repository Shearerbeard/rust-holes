#!/usr/bin/env python3
"""rust-holes self-check. Run from the repo root: bin/check

Exit 0 when every rule passes. Otherwise print one line per defect as
`FAIL <rule>: <file>: <detail>` and exit 1. The rules are the ones
README.md ("Using it") promises: links, template-header,
template-stamp, readme-read-order, never-publish.
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LINK_RE = re.compile(r"\[[^\]]*\]\(([^)]+)\)")
TICK_RE = re.compile(r"`((?:\.\./|templates/|examples/)[A-Za-z0-9_./-]+\.md)`")
STAMP = (
    "When you copy this file, record `copied from rust-holes@<sha>` in "
    "the copy, where `<sha>` is this repo's HEAD at copy time."
)
PRIVATE_OPENING = "**Private.**"


def md_files():
    files = []
    for d in (ROOT, ROOT / "templates", ROOT / "examples", ROOT / "docs"):
        if d.is_dir():
            files.extend(p for p in d.rglob("*.md") if "scratch" not in p.parts)
    return sorted(set(files))


def rel(path):
    return str(path.relative_to(ROOT))


def paragraphs(text):
    """Paragraphs as whitespace-normalized strings, in order."""
    out, cur = [], []
    for line in text.splitlines():
        if line.strip():
            cur.append(line.strip())
        elif cur:
            out.append(" ".join(cur))
            cur = []
    if cur:
        out.append(" ".join(cur))
    return out


def opening_paragraph(text):
    """The first paragraph after the `# title` line, or '' if none."""
    paras = paragraphs(text)
    if not paras or not paras[0].startswith("# "):
        return ""
    return paras[1] if len(paras) > 1 else ""


def check_links(failures):
    for f in md_files():
        text = f.read_text(encoding="utf-8")
        targets = LINK_RE.findall(text) + TICK_RE.findall(text)
        for raw in targets:
            target = raw.strip()
            if target.startswith("<") and target.endswith(">"):
                target = target[1:-1]
            target = target.split("#", 1)[0].split(" ", 1)[0].strip()
            if not target or target.startswith(("http://", "https://", "mailto:")):
                continue
            if not target.endswith(".md"):
                continue
            candidates = [f.parent / target]
            if target.startswith(("templates/", "examples/")):
                candidates.append(ROOT / target)
            if not any(c.exists() for c in candidates):
                failures.append(f"FAIL links: {rel(f)}: {raw} does not resolve")


def check_templates(failures):
    for f in sorted((ROOT / "templates").glob("*.md")):
        opening = opening_paragraph(f.read_text(encoding="utf-8"))
        if not opening.startswith("Template."):
            failures.append(
                f"FAIL template-header: {rel(f)}: the paragraph after the title must begin with 'Template.'"
            )
        if STAMP not in opening:
            failures.append(
                f"FAIL template-stamp: {rel(f)}: the opening paragraph must carry the copy-stamp instruction verbatim"
            )


def read_order_paths(readme):
    """First-column paths of the README read-order table."""
    paths = set()
    for line in readme.splitlines():
        m = re.match(r"^\|\s*`([^`]+)`\s*\|", line)
        if m:
            paths.add(m.group(1).strip())
    return paths


def check_readme(failures):
    readme = (ROOT / "README.md").read_text(encoding="utf-8")
    listed = read_order_paths(readme)
    for d in ("templates", "examples"):
        for f in sorted((ROOT / d).glob("*.md")):
            if f"{d}/{f.name}" not in listed:
                failures.append(
                    f"FAIL readme-read-order: README.md: {d}/{f.name} is not a row of the read-order table"
                )
    if not opening_paragraph(readme).startswith(PRIVATE_OPENING):
        failures.append(
            "FAIL never-publish: README.md: the paragraph after the title must begin with '**Private.**'"
        )


def main():
    failures = []
    check_links(failures)
    check_templates(failures)
    check_readme(failures)
    if failures:
        print("\n".join(failures))
        return 1
    print(f"OK: {len(md_files())} files checked")
    return 0


if __name__ == "__main__":
    sys.exit(main())
